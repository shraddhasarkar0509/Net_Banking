<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetBanking | Welcome</title>

    <link rel="stylesheet" href="FrontPage.css">
</head>

<body>

    <div class="page-container">

        <!-- Navigation Bar -->
        <header class="navbar">

        <a href="FrontPage.jsp" class="brand">
        <div class="brand-icon">N</div>

                <div class="brand-name">
                    <h2>NETBANKING</h2>
                    <span>YOUR BANKING PARTNER</span>
                </div>
            </a>

            <div class="nav-right">
                <span class="secure-label">
                    <span class="secure-dot"></span>
                    Secure Online Banking
                </span>
            </div>

        </header>

        <!-- Main Welcome Section -->
        <main class="main-content">

            <section class="welcome-card">

                <div class="left-content">

                    <div class="welcome-label">
                        WELCOME TO DIGITAL BANKING
                    </div>

                    <h1>
                        Banking made<br>
                        <span>simple and secure.</span>
                    </h1>

                    <p class="description">
                        Manage your money with confidence.
                        Access your banking services through
                        a simple, convenient and secure platform.
                    </p>

                    <a href="First.jsp" class="start-button">
                        Access NetBanking
                        <span class="arrow">&rarr;</span>
                    </a>

                    <p class="helper-text">
                        Get started with your banking journey today.
                    </p>

                </div>

                <!-- Right Side Illustration -->
                <div class="right-content">

                    <div class="circle circle-one"></div>
                    <div class="circle circle-two"></div>

                    <div class="bank-illustration">

                        <div class="illustration-top">
                            <span class="mini-dot"></span>
                            <span class="mini-dot"></span>
                            <span class="mini-dot"></span>
                            <span class="illustration-title">
                                YOUR FINANCES
                            </span>
                        </div>

                        <div class="balance-label">
                            Banking at your fingertips
                        </div>

                        <div class="balance-amount">
                            <span class="rupee-symbol">&#8377;</span>
                            <span class="balance-stars">**** ****</span>
                        </div>

                        <div class="card-divider"></div>

                        <div class="account-info">
                            <div class="info-item">
                                <div class="info-icon">&#8599;</div>
                                <div>
                                    <span>Easy Access</span>
                                    <strong>Anytime</strong>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon">&#10003;</div>
                                <div>
                                    <span>Security</span>
                                    <strong>Protected</strong>
                                </div>
                            </div>
                        </div>

                        <div class="card-bottom">
                            <span class="bottom-shield">&#10003;</span>
                            Your trust, our priority
                        </div>

                    </div>

                    <div class="floating-badge">
                        <span class="badge-check">&#10003;</span>
                        <div>
                            <strong>Safe &amp; Secure</strong>
                            <span>Bank with confidence</span>
                        </div>
                    </div>

                </div>

            </section>

            <!-- Features -->
            <section class="features">

                <div class="feature">
                    <div class="feature-icon">&#128274;</div>
                    <div>
                        <h3>Secure Banking</h3>
                        <p>Your banking experience matters.</p>
                    </div>
                </div>

                <div class="feature">
                    <div class="feature-icon">&#9889;</div>
                    <div>
                        <h3>Quick Access</h3>
                        <p>Access your banking services easily.</p>
                    </div>
                </div>

                <div class="feature">
                    <div class="feature-icon">&#128179;</div>
                    <div>
                        <h3>Easy Management</h3>
                        <p>Manage your banking in one place.</p>
                    </div>
                </div>

            </section>

        </main>

        <!-- Footer -->
        <footer class="footer">
            <p>&copy; 2026 NetBanking. All Rights Reserved.</p>
            <p class="footer-right">
                Designed for a simpler banking experience.
            </p>
        </footer>

    </div>

</body>
</html>
